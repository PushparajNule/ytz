generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(uuid())
  username String @unique
  email String @unique
  password String

  avatar String?
  coverImage String?

  description String?

  posts Post[] @relation("owner")
  playlist PlayList[]
  watchlist WatchList[]
  watchhistory WatchHistory[]

  subscribers Subscription[] @relation("subscriber")
  subscribedTo Subscription[] @relation("channel")

  likedPosts Likes[]

  refreshToken String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id String @id @default(uuid())
  owner String
  status Status

  watchlist WatchList[]
  playlistItem PlayListItem[]
  watchhistory WatchHistory[]

  title String
  description String?
  thumbnail String?
  video String
  thumbnailPublicURL String?
  videoPublicURL String

  likes Likes[]

  user User @relation("owner", fields: [owner], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PlayList {
  id String @id @default(uuid())
  userId String
  status Status
  items PlayListItem[]

  title String
  description String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
}

model PlayListItem {
  playlistId String
  postId String

  playlist PlayList @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  addedAt DateTime @default(now())

  @@id([playlistId, postId])
  @@index([playlistId, addedAt])
}

model WatchList {
  userId String
  postId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  addedAt DateTime @default(now())

  @@id([userId, postId])
  @@index([userId, addedAt])
}

model Subscription {
  subscriberId String
  channelId String

  subscriber User @relation("subscriber", fields: [subscriberId], references: [id], onDelete: Cascade)
  channel User @relation("channel", fields: [channelId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([subscriberId, channelId])
  @@index([subscriberId, createdAt])
  @@index([channelId, createdAt])
}

model Likes {
  userId String
  postId String

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, postId])
  @@index([userId, createdAt])
  @@index([postId, createdAt])
}

model WatchHistory {
  userId String
  postId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  watchedAt DateTime @default(now())

  @@id([userId, postId])
  @@index([userId, watchedAt])

}

enum Status {
  PUBLIC
  PRIVATE
}